{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twenty-nine-eleven-contact",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-09",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "contact.twentynineeleven.net", "custom_domain": true }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ottotheautonomous.github.io,https://michaeljameshofer.github.io,https://twentynineeleven.net,https://www.twentynineeleven.net"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contact@twentynineeleven.net",
      "allowed_sender_addresses": ["enquiry@twentynineeleven.net"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2911001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
