# Public endpoint only. Never put Supabase keys (or any other secret) in VITE_ variables; the Worker alone holds them.
VITE_CONTACT_ENDPOINT=https://contact.twentynineeleven.net/api/contact
# Cloudflare Turnstile site key (public). Leave empty to build without the bot check; the Worker enforces it only when
# TURNSTILE_SECRET is set with `wrangler secret put TURNSTILE_SECRET`.
VITE_TURNSTILE_SITE_KEY=
# Test builds only: keep ?debug (fps readout, window.__tne) in a production bundle. Never set this for the published site.
VITE_DEBUG_HOOKS=
